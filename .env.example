# Export these variables in your shell. The code does not read key files.
OPENROUTER_API_KEY=
APIFY_TOKEN=
# Network/API use is opt-in; cache-only runs are the default.
ODD_LOTS_ALLOW_NETWORK=0
# Opt in separately to retry previously cached model failures.
ODD_LOTS_RETRY_ERRORS=0
# Optional private work directory; default is private/ inside the project.
ODD_LOTS_PRIVATE_DIR=
# Optional descriptive SEC User-Agent for a fresh security-list download.
SEC_USER_AGENT=

